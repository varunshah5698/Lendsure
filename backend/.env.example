# LendSure backend configuration — copy to .env and fill in. NEVER commit .env.
# OTP / demo
LENDSURE_DEMO_OTP=1
LENDSURE_OTP_TTL_MIN=5
# CORS: comma-separated allowed origins (no "*" in production)
LENDSURE_CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://localhost:5173
# Max JSON body size in bytes
LENDSURE_MAX_BODY_BYTES=1000000
# External providers (all called server-side only; keys never reach the browser)
# Live market prices need NO key (Yahoo Finance, auto-refresh every 15 min).
# Live headlines need a free NewsAPI.org key (https://newsapi.org/register —
# free tier: 100 req/day). Without it, realistic seeded data is used.
NEWS_API_KEY=
# Gmail OTP delivery: your Gmail address + an App Password
# (Google Account → Security → 2-Step Verification → App passwords).
# Never use your real Gmail password here. Leave empty for demo mode
# (codes are shown on screen instead of emailed).
LENDSURE_SMTP_USER=
LENDSURE_SMTP_APP_PASSWORD=
